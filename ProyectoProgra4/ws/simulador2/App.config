<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="ServicioAlmacenSoap" />
                <binding name="ServicioAutenticacionSoap" />
                <binding name="ServicioVerificadorSoap" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:5100/ServicioAlmacen.asmx"
                binding="basicHttpBinding" bindingConfiguration="ServicioAlmacenSoap"
                contract="RefWsAlmacen.ServicioAlmacenSoap" name="ServicioAlmacenSoap" />
            <endpoint address="http://localhost:5300/ServicioAutenticacion.asmx"
                binding="basicHttpBinding" bindingConfiguration="ServicioAutenticacionSoap"
                contract="RefWsAutenticacion.ServicioAutenticacionSoap" name="ServicioAutenticacionSoap" />
            <endpoint address="http://localhost:5200/ServicioVerificador.asmx"
                binding="basicHttpBinding" bindingConfiguration="ServicioVerificadorSoap"
                contract="RefWsVerificador.ServicioVerificadorSoap" name="ServicioVerificadorSoap" />
        </client>
    </system.serviceModel>
</configuration>