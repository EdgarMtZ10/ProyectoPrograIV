<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="ServicioAlmacenSoap" />
                <binding name="ServicioAutenticacionSoap" />
                <binding name="ServicioVerificadorSoap" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:5100/ServicioAlmacen.asmx" binding="basicHttpBinding" bindingConfiguration="ServicioAlmacenSoap" contract="RefWsAlmacen.ServicioAlmacenSoap" name="ServicioAlmacenSoap" />
            <endpoint address="http://localhost:5300/ServicioAutenticacion.asmx" binding="basicHttpBinding" bindingConfiguration="ServicioAutenticacionSoap" contract="RefWsAutenticacion.ServicioAutenticacionSoap" name="ServicioAutenticacionSoap" />
            <endpoint address="http://localhost:5200/ServicioVerificador.asmx" binding="basicHttpBinding" bindingConfiguration="ServicioVerificadorSoap" contract="RefWsVerificador.ServicioVerificadorSoap" name="ServicioVerificadorSoap" />
        </client>
    </system.serviceModel>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>