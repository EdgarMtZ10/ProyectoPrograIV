<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="ServicioAlmacenSoap" />
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:5100/ServicioAlmacen.asmx"
                binding="basicHttpBinding" bindingConfiguration="ServicioAlmacenSoap"
                contract="RefWsAlmacen.ServicioAlmacenSoap" name="ServicioAlmacenSoap" />
        </client>
    </system.serviceModel>
</configuration>