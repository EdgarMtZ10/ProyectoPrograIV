<configuration>
	<!-- Cadena de conexion con autenticacion integrada de Windows hacia SQL Server -->
	<connectionStrings>
		<add name="NovaOnlineAlmacenConn"
			 connectionString="Server=localhost;Database=NovaOnlineAlmacen;Integrated Security=True;"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>
	<system.web>
		<!-- Compilacion en modo produccion sin informacion de depuracion -->
		<compilation debug="false" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />
	</system.web>
</configuration>