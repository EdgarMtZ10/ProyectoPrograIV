@* Vista de detalle de una compra especifica (Historia ADM4) *@
@model WebAdmin.WsConsultasAlmacenRef.CompraDetalleDto
@{
    ViewBag.Title = "Detalle de Compra";
    string fechaMostrar = (Model != null && Model.FechaCompra != null && Model.FechaCompra.Length == 8)
        ? Model.FechaCompra.Substring(6, 2) + "/" + Model.FechaCompra.Substring(4, 2) + "/" + Model.FechaCompra.Substring(0, 4)
        : (Model != null ? Model.FechaCompra : string.Empty);
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
<link href="@Url.Content("~/Content/almacen.css")" rel="stylesheet" type="text/css" />

<div class="ed-shell">
    <header class="ed-header">
        <span class="ed-kicker">Almacen / Ingresos</span>
        <h2>Detalle de Compra</h2>
    </header>

    @if (ViewBag.ErrorServicio != null)
    {
        <div class="ed-notice ed-notice--error">@ViewBag.ErrorServicio</div>
    }

    @if (Model != null)
    {
        <div class="ed-meta-list">
            <div class="ed-meta-row">
                <span class="ed-meta-term">Numero de Ingreso</span>
                <span class="ed-meta-val">@Model.NumeroIngreso</span>
            </div>
            <div class="ed-meta-row">
                <span class="ed-meta-term">Fecha de Compra</span>
                <span class="ed-meta-val">@fechaMostrar</span>
            </div>
            <div class="ed-meta-row">
                <span class="ed-meta-term">Cedula Juridica</span>
                <span class="ed-meta-val">@Model.CedulaJuridica</span>
            </div>
            <div class="ed-meta-row">
                <span class="ed-meta-term">Proveedor</span>
                <span class="ed-meta-val">@Model.NombreEmpresa</span>
            </div>
        </div>

        <h3 class="ed-section-title">Productos Ingresados</h3>
        <div class="ed-table-wrap">
            <table class="ed-table">
                <thead>
                    <tr>
                        <th>Codigo de Producto</th>
                        <th>Nombre del Producto</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lineas != null && Model.Lineas.Any())
                    {
                        foreach (var linea in Model.Lineas)
                        {
                            <tr>
                                <td>@linea.Codigo</td>
                                <td>@linea.Nombre</td>
                                <td>@linea.Cantidad</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3">Esta compra no tiene lineas registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="ed-actions">
        <a href="@Url.Action("Index", "Compras")" class="ed-btn">Volver al Listado</a>
    </div>
</div>